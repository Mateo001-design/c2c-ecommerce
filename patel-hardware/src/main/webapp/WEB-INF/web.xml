<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Patel Hardware Web Application</display-name>

    <!-- Login Servlet -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.patelhardware.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/api/login</url-pattern>
    </servlet-mapping>

    <!-- Registration Servlet -->
    <servlet>
        <servlet-name>RegistrationServlet</servlet-name>
        <servlet-class>com.patelhardware.servlet.RegistrationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegistrationServlet</servlet-name>
        <url-pattern>/api/register</url-pattern>
    </servlet-mapping>

    <!-- Main Servlet -->
    <servlet>
        <servlet-name>MainServlet</servlet-name>
        <servlet-class>com.patelhardware.servlet.MainServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MainServlet</servlet-name>
        <url-pattern>/api/main</url-pattern>
    </servlet-mapping>

    <!-- View All Items Servlet -->
    <servlet>
        <servlet-name>ViewAllServlet</servlet-name>
        <servlet-class>com.patelhardware.servlet.ViewAllServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ViewAllServlet</servlet-name>
        <url-pattern>/api/items</url-pattern>
    </servlet-mapping>

    <!-- Buy Items Servlet -->
    <servlet>
        <servlet-name>BuyItemsServlet</servlet-name>
        <servlet-class>com.patelhardware.servlet.BuyItemsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BuyItemsServlet</servlet-name>
        <url-pattern>/api/buy</url-pattern>
    </servlet-mapping>

    <!-- View Cart Items Servlet -->
    <servlet>
        <servlet-name>ViewCartItemsServlet</servlet-name>
        <servlet-class>com.patelhardware.servlet.ViewCartItemsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ViewCartItemsServlet</servlet-name>
        <url-pattern>/api/cart</url-pattern>
    </servlet-mapping>

    <!-- Search Items Servlet -->
    <servlet>
        <servlet-name>SearchItemsServlet</servlet-name>
        <servlet-class>com.patelhardware.servlet.SearchItemsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SearchItemsServlet</servlet-name>
        <url-pattern>/api/search</url-pattern>
    </servlet-mapping>

    <!-- Welcome file - login page -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!-- Session timeout set to 30 minutes -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>
